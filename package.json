{
  "name": "dsh-stm32",
  "version": "0.1.7",
  "description": "DSH 插件：STM32 全流程工具层（HAL 多族 + 寄存器 21 族）—— 环境探测、.ioc 事务、生成工程、编译、烧录、调试；芯片事实与模板随包内置",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "templates",
    "assets",
    "docs/reading-guide.md",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-client.mjs && node scripts/copy-data.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/run-units.mjs",
    "prepublishOnly": "npm run build",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:size": "node scripts/pack-size.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "stm32",
    "stm32f103c8t6",
    "cortex-m3",
    "arm",
    "embedded",
    "firmware",
    "stm32cubemx",
    "openocd",
    "cmsis-dap",
    "gdb"
  ],
  "license": "MIT",
  "author": "dsh-stm32 contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JingYu-er/dsh-stm32.git"
  },
  "homepage": "https://github.com/JingYu-er/dsh-stm32#readme",
  "bugs": {
    "url": "https://github.com/JingYu-er/dsh-stm32/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.2"
  }
}
